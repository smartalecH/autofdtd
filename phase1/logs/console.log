+def _resolved_grid_to_ir(value: ResolvedGrid) -> ResolvedGridIR:
+    return ResolvedGridIR(
+        center=value.center,
+        size=value.size,
+        x=_resolved_grid_axis_to_ir(value.x),
+        y=_resolved_grid_axis_to_ir(value.y),
+        z=_resolved_grid_axis_to_ir(value.z),
+        shape=value.shape,
