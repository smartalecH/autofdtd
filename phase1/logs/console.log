+class PMLParams(TaggedModel):
+    """Polynomial profile parameters for the Phase 1 baseline PML."""
 
+    type: Literal["PMLParams"] = "PMLParams"
+    sigma_order: int = 3
+    sigma_min: float = 0.0
+    sigma_max: float = 1.5
+    kappa_order: int = 3
+    kappa_min: float = 1.0
+    kappa_max: float = 3.0
+    alpha_order: int = 1
+    alpha_min: float = 0.0
+    alpha_max: float = 0.0
 
+    @field_validator("sigma_order", "kappa_order", "alpha_order")
+    @classmethod
+    def _validate_order(cls, value: int) -> int:
+        if value < 0:
+            raise ValueError("PML profile orders must be non-negative")
+        return int(value)
+
+    @field_validator(
+        "sigma_min",
+        "sigma_max",
+        "kappa_min",
+        "kappa_max",
+        "alpha_min",
+        "alpha_max",
