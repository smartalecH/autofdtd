+    after_left = float(np.sum(electric[1:5, ...] ** 2))
+    after_right_h = float(np.sum(magnetic[-5:-1, ...] ** 2))
+
+    assert after_left < before_left * 0.1
+    assert after_right_h < 0.1 * 16.0
