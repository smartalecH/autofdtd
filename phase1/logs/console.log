+def test_anisotropic_kernel_updates_apply_axis_specific_paths() -> None:
+    coeffs = compile_anisotropic_medium_coefficients(
+        AnisotropicMedium(
+            xx=Medium(permittivity=2.0),
+            yy=PoleResidue(eps_inf=2.5, poles=(((-2.0e12, 0.0), (8.0e10, 0.0)),)),
+            zz=PECMedium(),
