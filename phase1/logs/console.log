+        lower = _positive_finite(float(value[0]), field_name="frequency_range[0]")
+        upper = _positive_finite(float(value[1]), field_name="frequency_range[1]")
+        if upper <= lower:
+            raise ValueError("frequency_range must be strictly increasing")
+        return (lower, upper)
