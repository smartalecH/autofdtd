+    if isinstance(grid, UniformGrid):
+        return UniformGridIR(dl=grid.dl)
+    if isinstance(grid, CustomGridBoundaries):
+        return CustomGridBoundariesIR(coords=grid.coords)
+    if isinstance(grid, CustomGrid):
