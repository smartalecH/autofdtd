+    with pytest.raises(ValueError, match="out of bounds"):
+        Simulation(size=(1.0, 1.0, 1.0), run_time=1.0, normalize_index=0)
+
+    with pytest.raises(ValueError, match="zero-amplitude source"):
+        Simulation(
+            size=(1.0, 1.0, 1.0),
+            run_time=1.0,
+            sources=(zero_amplitude,),
+            normalize_index=0,
+        )
