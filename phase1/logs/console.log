index 0000000000000000000000000000000000000000..bfe6789ad6adc4b0b16497d00af15a962c828813
--- /dev/null
+++ b/src/autofdtd/examples/boundaries.py
@@ -0,0 +1,19 @@
+"""Examples for the foundational non-absorbing boundary subset."""
+
+from __future__ import annotations
+
+from autofdtd.api import Boundary, BoundarySpec
+from autofdtd.compiler import compile_boundary_spec
+
+
+def boundary_runtime_snapshot() -> dict[str, object]:
+    """Return a JSON-ready snapshot of the compiled Phase 1 boundary runtime metadata."""
+
+    compiled = compile_boundary_spec(
+        BoundarySpec(
+            x=Boundary.periodic(),
+            y=Boundary.pec(),
+            z=Boundary.pmc(),
+        )
+    )
