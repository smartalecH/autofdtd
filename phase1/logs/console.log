+    ) -> float | BroadbandModeABCSpec | None:
+        if value is None or isinstance(value, BroadbandModeABCSpec):
+            return value
+        if isinstance(value, Mapping):
+            return BroadbandModeABCSpec(**value)
+        normalized = float(value)
+        if normalized <= 0.0:
