+        if edge_types == {"Periodic"}:
+            periodic_axes.append(axis_name)
+        else:
+            reflective_axes.append(axis_name)
+    return BoundarySpecIR(
+        x=axes["x"],
+        y=axes["y"],
+        z=axes["z"],
+        periodic_axes=tuple(periodic_axes),
+        reflective_axes=tuple(reflective_axes),
+    )
