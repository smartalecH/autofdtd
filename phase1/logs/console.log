+def _resolved_grid_axis_to_ir(value: ResolvedGridAxis) -> ResolvedGridAxisIR:
+    return ResolvedGridAxisIR(
+        axis=value.axis,
+        boundaries=value.boundaries,
+        cell_sizes=value.cell_sizes,
