+def test_sellmeier_model_validates_matches_formula_and_lowers_to_pole_residue() -> None:
+    medium = Sellmeier(
+        name=" silica ",
+        coeffs=((0.6961663, 4.67914825849e-15), (0.4079426, 0.0)),
