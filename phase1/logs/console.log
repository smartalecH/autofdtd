+                value_shape=value_shape,
+                previous_boundary=np.zeros(value_shape, dtype=dtype),
+                previous_adjacent=np.zeros(value_shape, dtype=dtype),
+            )
+    return ABCBoundaryState(electric=electric, magnetic=magnetic)
+
