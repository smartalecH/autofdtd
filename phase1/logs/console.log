{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_uofp6ioh9ckl_1","type":"tool_result","content":"1\t\"\"\"Source-time profile models for Phase 1 source families.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport math\n6\tfrom collections.abc import Mapping, Sequence\n7\tfrom typing import Literal\n8\t\n9\timport numpy as np\n10\tfrom pydantic import Field, field_validator\n11\t\n12\tfrom autofdtd.core.models import TaggedModel\n13\t\n14\tDEFAULT_SIGMA = 4.0\n15\tEND_TIME_FACTOR_GAUSSIAN = 10.0\n16\t\n17\t\n18\tdef _finite_float(value: float, *, field_name: str) -> float:\n19\t    normalized = float(value)\n20\t    if not math.isfinite(normalized):\n21\t        raise ValueError(f\"{field_name} must be finite\")\n22\t    return normalized\n23\t\n24\t\n25\tdef _positive_finite(value: float, *, field_name: str) -> float:\n26\t    normalized = _finite_float(value, field_name=field_name)\n27\t    if normalized <= 0.0:\n28\t        raise ValueError(f\"{field_name} must be a positive finite value\")\n29\t    return normalized\n30\t\n31\t\n32\tdef _non_negative_finite(value: float, *, field_name: str) -> float:\n33\t    normalized = _finite_float(value, field_name=field_name)\n34\t    if normalized < 0.0:\n35\t        raise ValueError(f\"{field_name} must be a non-negative finite value\")\n36\t    return normalized\n37\t\n38\t\n39\tdef _normalize_times(time: float | Sequence[float]) -> np.ndarray:\n40\t    values = np.asarray(time, dtype=float)\n41\t    if values.ndim == 0:\n42\t        values = values.reshape(1)\n43\t    if values.ndim != 1:\n44\t        raise ValueError(\"time samples must be a scalar or one-dimensional sequence\")\n45\t    if not np.all(np.isfinite(values)):\n46\t        raise ValueError(\"time samples must be finite\")\n47\t    return values\n48\t\n49\t\n50\tclass SourceTime(TaggedModel):\n51\t    \"\"\"Base class for time-domain source envelopes.\"\"\"\n52\t\n53\t    type: str = \"SourceTime\"\n54\t    amplitude: float = 1.0\n55\t    phase: float = 0.0\n56\t\n57\t    @field_validator(\"amplitude\")\n58\t    @classmethod\n59\t    def _validate_amplitude(cls, value: float) -> float:\n60\t        return _non_negative_finite(value, field_name=\"amplitude\")\n61\t\n62\t    @field_validator(\"phase\")\n63\t    @classmethod\n64\t    def _validate_phase(cls, value: float) -> float:\n65\t        return _finite_float(value, field_name=\"phase\")\n66\t\n67\t    def amp_complex(self) -> complex:\n68\t        \"\"\"Return the complex-valued scalar amplitude.\"\"\"\n69\t\n70\t        return self.amplitude * complex(math.cos(self.phase), math.sin(self.phase))\n71\t\n72\t    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n73\t        \"\"\"Evaluate the complex source amplitude at one or more times.\"\"\"\n74\t\n75\t        raise NotImplementedError\n76\t\n77\t    def end_time(self) -> float | None:\n78\t        \"\"\"Return the time after which the source is effectively inactive.\"\"\"\n79\t\n80\t        raise NotImplementedError\n81\t\n82\t\n83\tclass Pulse(SourceTime):\n84\t    \"\"\"Carrier-modulated source-time profile with finite ramp bandwidth.\"\"\"\n85\t\n86\t    type: str = \"Pulse\"\n87\t    freq0: float\n88\t    fwidth: float\n89\t    offset: float = Field(default=5.0, ge=2.5)\n90\t\n91\t    @field_validator(\"freq0\")\n92\t    @classmethod\n93\t    def _validate_freq0(cls, value: float) -> float:\n94\t        return _positive_finite(value, field_name=\"freq0\")\n95\t\n96\t    @field_validator(\"fwidth\")\n97\t    @classmethod\n98\t    def _validate_fwidth(cls, value: float) -> float:\n99\t        return _positive_finite(value, field_name=\"fwidth\")\n100\t\n101\t    @property\n102\t    def twidth(self) -> float:\n103\t        \"\"\"Envelope width in seconds.\"\"\"\n104\t\n105\t        return 1.0 / (2.0 * math.pi * self.fwidth)\n106\t\n107\t    @property\n108\t    def offset_time(self) -> float:\n109\t        \"\"\"Envelope delay in seconds.\"\"\"\n110\t\n111\t        return self.offset * self.twidth\n112\t\n113\t    def frequency_range(self, num_fwidth: float = DEFAULT_SIGMA) -> tuple[float, float]:\n114\t        \"\"\"Return the carrier frequency range covered by this profile.\"\"\"\n115\t\n116\t        sigma = _positive_finite(num_fwidth, field_name=\"num_fwidth\")\n117\t        return (max(0.0, self.freq0 - sigma * self.fwidth), self.freq0 + sigma * self.fwidth)\n118\t\n119\t\n120\tclass GaussianPulse(Pulse):\n121\t    \"\"\"Gaussian-envelope source-time profile.\"\"\"\n122\t\n123\t    type: Literal[\"GaussianPulse\"] = \"GaussianPulse\"\n124\t    remove_dc_component: bool = True\n125\t\n126\t    @property\n127\t    def peak_time(self) -> float:\n128\t        return self.offset * self.twidth\n129\t\n130\t    @property\n131\t    def peak_frequency(self) -> float:\n132\t        if not self.remove_dc_component:\n133\t            return self.freq0\n134\t        return 0.5 * (self.freq0 + math.sqrt(self.freq0**2 + 4.0 * self.fwidth**2))\n135\t\n136\t    @property\n137\t    def _peak_time_shift(self) -> float:\n138\t        if self.remove_dc_component and self.fwidth > self.freq0:\n139\t            return self.twidth * math.sqrt(1.0 - self.freq0**2 / self.fwidth**2)\n140\t        return 0.0\n141\t\n142\t    @property\n143\t    def offset_time(self) -> float:\n144\t        return self.peak_time + self._peak_time_shift\n145\t\n146\t    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n147\t        times = _normalize_times(time)\n148\t        omega0 = 2.0 * math.pi * self.freq0\n149\t        time_shifted = times - self.offset_time\n150\t        base = (\n151\t            np.exp(1j * self.phase)\n152\t            * np.exp(-1j * omega0 * times)\n153\t            * np.exp(-(time_shifted**2) / (2.0 * self.twidth**2))\n154\t            * self.amplitude\n155\t        )\n156\t        if self.remove_dc_component:\n157\t            corrected = base * (1j * omega0 + time_shifted / (self.twidth**2))\n158\t            return corrected / (2.0 * math.pi * self.peak_frequency)\n159\t        return 1j * base\n160\t\n161\t    def end_time(self) -> float:\n162\t        end_time = self.offset_time + END_TIME_FACTOR_GAUSSIAN * self.twidth\n163\t        if self.remove_dc_component and self.fwidth > self.freq0:\n164\t            end_time += 2.0 * self._peak_time_shift\n165\t        return end_time\n166\t\n167\t\n168\tclass ContinuousWave(Pulse):\n169\t    \"\"\"Logistic-ramp continuous-wave source-time profile.\"\"\"\n170\t\n171\t    type: Literal[\"ContinuousWave\"] = \"ContinuousWave\"\n172\t\n173\t    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n174\t        times = _normalize_times(time)\n175\t        omega0 = 2.0 * math.pi * self.freq0\n176\t        time_shifted = times - self.offset_time\n177\t        ramp = 1.0 / (1.0 + np.exp(-time_shifted / self.twidth))\n178\t        return (\n179\t            np.exp(1j * self.phase)\n180\t            * np.exp(-1j * omega0 * times)\n181\t            * ramp\n182\t            * self.amplitude\n183\t        )\n184\t\n185\t    def end_time(self) -> None:\n186\t        return None\n187\t\n188\t\n189\tdef _complex_pairs_to_array(values: Sequence[Sequence[float]]) -> np.ndarray:\n190\t    pairs = np.asarray(values, dtype=float)\n191\t    if pairs.ndim != 2 or pairs.shape[1] != 2:\n192\t        raise ValueError(\"complex sample values must be a sequence of (real, imag) pairs\")\n193\t    if not np.all(np.isfinite(pairs)):\n194\t        raise ValueError(\"complex sample values must be finite\")\n195\t    return pairs[:, 0] + 1j * pairs[:, 1]\n196\t\n197\t\n198\tdef _complex_array_to_pairs(values: Sequence[complex]) -> tuple[tuple[float, float], ...]:\n199\t    array = np.asarray(values, dtype=complex)\n200\t    if array.ndim != 1:\n201\t        raise ValueError(\"complex sample values must be one-dimensional\")\n202\t    if not np.all(np.isfinite(array.real)) or not np.all(np.isfinite(array.imag)):\n203\t        raise ValueError(\"complex sample values must be finite\")\n204\t    return tuple((float(value.real), float(value.imag)) for value in array)\n205\t\n206\t\n207\tclass CustomSourceTime(Pulse):\n208\t    \"\"\"Interpolated custom envelope modulated by a harmonic carrier.\"\"\"\n209\t\n210\t    type: Literal[\"CustomSourceTime\"] = \"CustomSourceTime\"\n211\t    offset: float = 0.0\n212\t    time_samples: tuple[float, ...]\n213\t    envelope_values: tuple[tuple[float, float], ...]\n214\t\n215\t    @field_validator(\"time_samples\")\n216\t    @classmethod\n217\t    def _validate_time_samples(cls, value: tuple[float, ...]) -> tuple[float, ...]:\n218\t        if len(value) <= 1:\n219\t            raise ValueError(\"CustomSourceTime requires more than one time sample\")\n220\t        normalized = tuple(_finite_float(item, field_name=\"time_samples\") for item in value)\n221\t        if any(later <= earlier for earlier, later in zip(normalized, normalized[1:], strict=False)):\n222\t            raise ValueError(\"CustomSourceTime time samples must be strictly increasing\")\n223\t        return normalized\n224\t\n225\t    @field_validator(\"envelope_values\")\n226\t    @classmethod\n227\t    def _validate_envelope_values(\n228\t        cls,\n229\t        value: tuple[tuple[float, float], ...],\n230\t        info,\n231\t    ) -> tuple[tuple[float, float], ...]:\n232\t        _complex_pairs_to_array(value)\n233\t        time_samples = info.data.get(\"time_samples\")\n234\t        if time_samples is not None and len(value) != len(time_samples):\n235\t            raise ValueError(\"CustomSourceTime envelope_values must match time_samples length\")\n236\t        return value\n237\t\n238\t    @classmethod\n239\t    def from_values(\n240\t        cls,\n241\t        *,\n242\t        freq0: float,\n243\t        fwidth: float,\n244\t        values: Sequence[complex],\n245\t        dt: float,\n246\t        amplitude: float = 1.0,\n247\t        phase: float = 0.0,\n248\t        offset: float = 0.0,\n249\t    ) -> \"CustomSourceTime\":\n250\t        sample_dt = _positive_finite(dt, field_name=\"dt\")\n251\t        sample_values = np.asarray(values, dtype=complex)\n252\t        if sample_values.ndim != 1:\n253\t            raise ValueError(\"values must be a one-dimensional sequence\")\n254\t        times = tuple(float(index * sample_dt) for index in range(sample_values.size))\n255\t        return cls(\n256\t            freq0=freq0,\n257\t            fwidth=fwidth,\n258\t            amplitude=amplitude,\n259\t            phase=phase,\n260\t            offset=offset,\n261\t            time_samples=times,\n262\t            envelope_values=_complex_array_to_pairs(sample_values),\n263\t        )\n264\t\n265\t    @property\n266\t    def envelope_complex(self) -> np.ndarray:\n267\t        return _complex_pairs_to_array(self.envelope_values)\n268\t\n269\t    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n270\t        times = _normalize_times(time)\n271\t        shifted = times - self.offset_time\n272\t        data_times = np.asarray(self.time_samples, dtype=float)\n273\t        data_values = self.envelope_complex\n274\t        envelope_real = np.interp(\n275\t            shifted,\n276\t            data_times,\n277\t            data_values.real,\n278\t            left=data_values.real[0],\n279\t            right=data_values.real[-1],\n280\t        )\n281\t        envelope_imag = np.interp(\n282\t            shifted,\n283\t            data_times,\n284\t            data_values.imag,\n285\t            left=data_values.imag[0],\n286\t            right=data_values.imag[-1],\n287\t        )\n288\t        envelope = envelope_real + 1j * envelope_imag\n289\t        omega0 = 2.0 * math.pi * self.freq0\n290\t        modulation = np.exp(1j * self.phase) * np.exp(-1j * omega0 * times)\n291\t        return self.amplitude * modulation * envelope\n292\t\n293\t    def end_time(self) -> float | None:\n294\t        magnitudes = np.abs(self.envelope_complex)\n295\t        non_zero = np.flatnonzero(~np.isclose(magnitudes, 0.0))\n296\t        if non_zero.size == 0:\n297\t            return None\n298\t        return self.offset_time + self.time_samples[int(non_zero[-1])]\n299\t\n300\t\n301\tclass BroadbandPulse(SourceTime):\n302\t    \"\"\"Broadband Gaussian subset defined by a target frequency interval.\"\"\"\n303\t\n304\t    type: Literal[\"BroadbandPulse\"] = \"BroadbandPulse\"\n305\t    freq_range: tuple[float, float]\n306\t    minimum_amplitude: float = Field(default=0.3, gt=0.05, lt=0.5)\n307\t    offset: float = 0.0\n308\t\n309\t    @field_validator(\"freq_range\")\n310\t    @classmethod\n311\t    def _validate_freq_range(cls, value: tuple[float, float]) -> tuple[float, float]:\n312\t        if len(value) != 2:\n313\t            raise ValueError(\"freq_range must contain exactly two elements\")\n314\t        fmin = _positive_finite(value[0], field_name=\"freq_range[0]\")\n315\t        fmax = _positive_finite(value[1], field_name=\"freq_range[1]\")\n316\t        if fmax <= fmin:\n317\t            raise ValueError(\"freq_range[1] must be greater than freq_range[0]\")\n318\t        return (fmin, fmax)\n319\t\n320\t    @property\n321\t    def freq0(self) -> float:\n322\t        return 0.5 * (self.freq_range[0] + self.freq_range[1])\n323\t\n324\t    @property\n325\t    def bandwidth(self) -> float:\n326\t        return self.freq_range[1] - self.freq_range[0]\n327\t\n328\t    @property\n329\t    def fwidth(self) -> float:\n330\t        half_range = 0.5 * self.bandwidth\n331\t        return half_range / math.sqrt(2.0 * math.log(1.0 / self.minimum_amplitude))\n332\t\n333\t    @property\n334\t    def twidth(self) -> float:\n335\t        return 1.0 / (2.0 * math.pi * self.fwidth)\n336\t\n337\t    @property\n338\t    def automatic_delay(self) -> float:\n339\t        return 5.0 * self.twidth\n340\t\n341\t    @property\n342\t    def offset_time(self) -> float:\n343\t        range_twidth = 1.0 / (2.0 * math.pi * self.bandwidth)\n344\t        return self.automatic_delay + self.offset * range_twidth\n345\t\n346\t    @property\n347\t    def peak_time(self) -> float:\n348\t        return self.offset_time\n349\t\n350\t    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n351\t        times = _normalize_times(time)\n352\t        omega0 = 2.0 * math.pi * self.freq0\n353\t        shifted = times - self.offset_time\n354\t        return (\n355\t            1j\n356\t            * np.exp(1j * self.phase)\n357\t            * np.exp(-1j * omega0 * times)\n358\t            * np.exp(-(shifted**2) / (2.0 * self.twidth**2))\n359\t            * self.amplitude\n360\t        )\n361\t\n362\t    def amp_freq(self, freq: float | Sequence[float]) -> np.ndarray:\n363\t        freqs = np.asarray(freq, dtype=float)\n364\t        if freqs.ndim == 0:\n365\t            freqs = freqs.reshape(1)\n366\t        if freqs.ndim != 1 or not np.all(np.isfinite(freqs)):\n367\t            raise ValueError(\"frequency samples must be a scalar or one-dimensional finite sequence\")\n368\t        spread = np.exp(-((freqs - self.freq0) ** 2) / (2.0 * self.fwidth**2))\n369\t        return self.amplitude * np.exp(1j * self.phase) * spread\n370\t\n371\t    def frequency_range_sigma(self, sigma: float = DEFAULT_SIGMA) -> tuple[float, float]:\n372\t        sigma_value = _positive_finite(sigma, field_name=\"sigma\")\n373\t        return (\n374\t            max(0.0, self.freq0 - sigma_value * self.fwidth),\n375\t            self.freq0 + sigma_value * self.fwidth,\n376\t        )\n377\t\n378\t    def frequency_range(self, num_fwidth: float = DEFAULT_SIGMA) -> tuple[float, float]:\n379\t        return self.frequency_range_sigma(sigma=num_fwidth)\n380\t\n381\t    def end_time(self) -> float:\n382\t        return self.offset_time + END_TIME_FACTOR_GAUSSIAN * self.twidth\n383\t\n384\t\n385\tSourceTimeModel = GaussianPulse | ContinuousWave | BroadbandPulse | CustomSourceTime\n386\t\n387\t\n388\tdef source_time_model_from_value(value: object) -> SourceTimeModel:\n389\t    \"\"\"Coerce a mapping payload into a supported Phase 1 source-time profile.\"\"\"\n390\t\n391\t    if isinstance(value, (GaussianPulse, ContinuousWave, BroadbandPulse, CustomSourceTime)):\n392\t        return value\n393\t    if not isinstance(value, Mapping):\n394\t        raise TypeError(f\"expected a mapping or source-time model, got {type(value)!r}\")\n395\t\n396\t    source_time_type = str(value.get(\"type\", \"\"))\n397\t    if source_time_type == \"GaussianPulse\":\n398\t        return GaussianPulse.model_validate(value)\n399\t    if source_time_type == \"ContinuousWave\":\n400\t        return ContinuousWave.model_validate(value)\n401\t    if source_time_type == \"BroadbandPulse\":\n402\t        return BroadbandPulse.model_validate(value)\n403\t    if source_time_type == \"CustomSourceTime\":\n404\t        return CustomSourceTime.model_validate(value)\n405\t    raise TypeError(f\"unsupported Phase 1 source-time type {source_time_type!r}\")\n406\t"}]},"parent_tool_use_id":null,"session_id":"9f649c44-f5ed-43a2-9485-dc3f20705005","uuid":"b2de810a-7247-4c8a-bd24-6e982b68c50d","timestamp":"2026-04-06T23:45:43.221Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/autofdtd/src/autofdtd/sources/time.py","content":"\"\"\"Source-time profile models for Phase 1 source families.\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom collections.abc import Mapping, Sequence\nfrom typing import Literal\n\nimport numpy as np\nfrom pydantic import Field, field_validator\n\nfrom autofdtd.core.models import TaggedModel\n\nDEFAULT_SIGMA = 4.0\nEND_TIME_FACTOR_GAUSSIAN = 10.0\n\n\ndef _finite_float(value: float, *, field_name: str) -> float:\n    normalized = float(value)\n    if not math.isfinite(normalized):\n        raise ValueError(f\"{field_name} must be finite\")\n    return normalized\n\n\ndef _positive_finite(value: float, *, field_name: str) -> float:\n    normalized = _finite_float(value, field_name=field_name)\n    if normalized <= 0.0:\n        raise ValueError(f\"{field_name} must be a positive finite value\")\n    return normalized\n\n\ndef _non_negative_finite(value: float, *, field_name: str) -> float:\n    normalized = _finite_float(value, field_name=field_name)\n    if normalized < 0.0:\n        raise ValueError(f\"{field_name} must be a non-negative finite value\")\n    return normalized\n\n\ndef _normalize_times(time: float | Sequence[float]) -> np.ndarray:\n    values = np.asarray(time, dtype=float)\n    if values.ndim == 0:\n        values = values.reshape(1)\n    if values.ndim != 1:\n        raise ValueError(\"time samples must be a scalar or one-dimensional sequence\")\n    if not np.all(np.isfinite(values)):\n        raise ValueError(\"time samples must be finite\")\n    return values\n\n\nclass SourceTime(TaggedModel):\n    \"\"\"Base class for time-domain source envelopes.\"\"\"\n\n    type: str = \"SourceTime\"\n    amplitude: float = 1.0\n    phase: float = 0.0\n\n    @field_validator(\"amplitude\")\n    @classmethod\n    def _validate_amplitude(cls, value: float) -> float:\n        return _non_negative_finite(value, field_name=\"amplitude\")\n\n    @field_validator(\"phase\")\n    @classmethod\n    def _validate_phase(cls, value: float) -> float:\n        return _finite_float(value, field_name=\"phase\")\n\n    def amp_complex(self) -> complex:\n        \"\"\"Return the complex-valued scalar amplitude.\"\"\"\n\n        return self.amplitude * complex(math.cos(self.phase), math.sin(self.phase))\n\n    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n        \"\"\"Evaluate the complex source amplitude at one or more times.\"\"\"\n\n        raise NotImplementedError\n\n    def end_time(self) -> float | None:\n        \"\"\"Return the time after which the source is effectively inactive.\"\"\"\n\n        raise NotImplementedError\n\n\nclass Pulse(SourceTime):\n    \"\"\"Carrier-modulated source-time profile with finite ramp bandwidth.\"\"\"\n\n    type: str = \"Pulse\"\n    freq0: float\n    fwidth: float\n    offset: float = Field(default=5.0, ge=2.5)\n\n    @field_validator(\"freq0\")\n    @classmethod\n    def _validate_freq0(cls, value: float) -> float:\n        return _positive_finite(value, field_name=\"freq0\")\n\n    @field_validator(\"fwidth\")\n    @classmethod\n    def _validate_fwidth(cls, value: float) -> float:\n        return _positive_finite(value, field_name=\"fwidth\")\n\n    @property\n    def twidth(self) -> float:\n        \"\"\"Envelope width in seconds.\"\"\"\n\n        return 1.0 / (2.0 * math.pi * self.fwidth)\n\n    @property\n    def offset_time(self) -> float:\n        \"\"\"Envelope delay in seconds.\"\"\"\n\n        return self.offset * self.twidth\n\n    def frequency_range(self, num_fwidth: float = DEFAULT_SIGMA) -> tuple[float, float]:\n        \"\"\"Return the carrier frequency range covered by this profile.\"\"\"\n\n        sigma = _positive_finite(num_fwidth, field_name=\"num_fwidth\")\n        return (max(0.0, self.freq0 - sigma * self.fwidth), self.freq0 + sigma * self.fwidth)\n\n\nclass GaussianPulse(Pulse):\n    \"\"\"Gaussian-envelope source-time profile.\"\"\"\n\n    type: Literal[\"GaussianPulse\"] = \"GaussianPulse\"\n    remove_dc_component: bool = True\n\n    @property\n    def peak_time(self) -> float:\n        return self.offset * self.twidth\n\n    @property\n    def peak_frequency(self) -> float:\n        if not self.remove_dc_component:\n            return self.freq0\n        return 0.5 * (self.freq0 + math.sqrt(self.freq0**2 + 4.0 * self.fwidth**2))\n\n    @property\n    def _peak_time_shift(self) -> float:\n        if self.remove_dc_component and self.fwidth > self.freq0:\n            return self.twidth * math.sqrt(1.0 - self.freq0**2 / self.fwidth**2)\n        return 0.0\n\n    @property\n    def offset_time(self) -> float:\n        return self.peak_time + self._peak_time_shift\n\n    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n        times = _normalize_times(time)\n        omega0 = 2.0 * math.pi * self.freq0\n        time_shifted = times - self.offset_time\n        base = (\n            np.exp(1j * self.phase)\n            * np.exp(-1j * omega0 * times)\n            * np.exp(-(time_shifted**2) / (2.0 * self.twidth**2))\n            * self.amplitude\n        )\n        if self.remove_dc_component:\n            corrected = base * (1j * omega0 + time_shifted / (self.twidth**2))\n            return corrected / (2.0 * math.pi * self.peak_frequency)\n        return 1j * base\n\n    def end_time(self) -> float:\n        end_time = self.offset_time + END_TIME_FACTOR_GAUSSIAN * self.twidth\n        if self.remove_dc_component and self.fwidth > self.freq0:\n            end_time += 2.0 * self._peak_time_shift\n        return end_time\n\n\nclass ContinuousWave(Pulse):\n    \"\"\"Logistic-ramp continuous-wave source-time profile.\"\"\"\n\n    type: Literal[\"ContinuousWave\"] = \"ContinuousWave\"\n\n    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n        times = _normalize_times(time)\n        omega0 = 2.0 * math.pi * self.freq0\n        time_shifted = times - self.offset_time\n        ramp = 1.0 / (1.0 + np.exp(-time_shifted / self.twidth))\n        return (\n            np.exp(1j * self.phase)\n            * np.exp(-1j * omega0 * times)\n            * ramp\n            * self.amplitude\n        )\n\n    def end_time(self) -> None:\n        return None\n\n\ndef _complex_pairs_to_array(values: Sequence[Sequence[float]]) -> np.ndarray:\n    pairs = np.asarray(values, dtype=float)\n    if pairs.ndim != 2 or pairs.shape[1] != 2:\n        raise ValueError(\"complex sample values must be a sequence of (real, imag) pairs\")\n    if not np.all(np.isfinite(pairs)):\n        raise ValueError(\"complex sample values must be finite\")\n    return pairs[:, 0] + 1j * pairs[:, 1]\n\n\ndef _complex_array_to_pairs(values: Sequence[complex]) -> tuple[tuple[float, float], ...]:\n    array = np.asarray(values, dtype=complex)\n    if array.ndim != 1:\n        raise ValueError(\"complex sample values must be one-dimensional\")\n    if not np.all(np.isfinite(array.real)) or not np.all(np.isfinite(array.imag)):\n        raise ValueError(\"complex sample values must be finite\")\n    return tuple((float(value.real), float(value.imag)) for value in array)\n\n\nclass CustomSourceTime(Pulse):\n    \"\"\"Interpolated custom envelope modulated by a harmonic carrier.\"\"\"\n\n    type: Literal[\"CustomSourceTime\"] = \"CustomSourceTime\"\n    offset: float = 0.0\n    time_samples: tuple[float, ...]\n    envelope_values: tuple[tuple[float, float], ...]\n\n    @field_validator(\"time_samples\")\n    @classmethod\n    def _validate_time_samples(cls, value: tuple[float, ...]) -> tuple[float, ...]:\n        if len(value) <= 1:\n            raise ValueError(\"CustomSourceTime requires more than one time sample\")\n        normalized = tuple(_finite_float(item, field_name=\"time_samples\") for item in value)\n        if any(later <= earlier for earlier, later in zip(normalized, normalized[1:], strict=False)):\n            raise ValueError(\"CustomSourceTime time samples must be strictly increasing\")\n        return normalized\n\n    @field_validator(\"envelope_values\")\n    @classmethod\n    def _validate_envelope_values(\n        cls,\n        value: tuple[tuple[float, float], ...],\n        info,\n    ) -> tuple[tuple[float, float], ...]:\n        _complex_pairs_to_array(value)\n        time_samples = info.data.get(\"time_samples\")\n        if time_samples is not None and len(value) != len(time_samples):\n            raise ValueError(\"CustomSourceTime envelope_values must match time_samples length\")\n        return value\n\n    @classmethod\n    def from_values(\n        cls,\n        *,\n        freq0: float,\n        fwidth: float,\n        values: Sequence[complex],\n        dt: float,\n        amplitude: float = 1.0,\n        phase: float = 0.0,\n        offset: float = 0.0,\n    ) -> \"CustomSourceTime\":\n        sample_dt = _positive_finite(dt, field_name=\"dt\")\n        sample_values = np.asarray(values, dtype=complex)\n        if sample_values.ndim != 1:\n            raise ValueError(\"values must be a one-dimensional sequence\")\n        times = tuple(float(index * sample_dt) for index in range(sample_values.size))\n        return cls(\n            freq0=freq0,\n            fwidth=fwidth,\n            amplitude=amplitude,\n            phase=phase,\n            offset=offset,\n            time_samples=times,\n            envelope_values=_complex_array_to_pairs(sample_values),\n        )\n\n    @property\n    def envelope_complex(self) -> np.ndarray:\n        return _complex_pairs_to_array(self.envelope_values)\n\n    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n        times = _normalize_times(time)\n        shifted = times - self.offset_time\n        data_times = np.asarray(self.time_samples, dtype=float)\n        data_values = self.envelope_complex\n        envelope_real = np.interp(\n            shifted,\n            data_times,\n            data_values.real,\n            left=data_values.real[0],\n            right=data_values.real[-1],\n        )\n        envelope_imag = np.interp(\n            shifted,\n            data_times,\n            data_values.imag,\n            left=data_values.imag[0],\n            right=data_values.imag[-1],\n        )\n        envelope = envelope_real + 1j * envelope_imag\n        omega0 = 2.0 * math.pi * self.freq0\n        modulation = np.exp(1j * self.phase) * np.exp(-1j * omega0 * times)\n        return self.amplitude * modulation * envelope\n\n    def end_time(self) -> float | None:\n        magnitudes = np.abs(self.envelope_complex)\n        non_zero = np.flatnonzero(~np.isclose(magnitudes, 0.0))\n        if non_zero.size == 0:\n            return None\n        return self.offset_time + self.time_samples[int(non_zero[-1])]\n\n\nclass BroadbandPulse(SourceTime):\n    \"\"\"Broadband Gaussian subset defined by a target frequency interval.\"\"\"\n\n    type: Literal[\"BroadbandPulse\"] = \"BroadbandPulse\"\n    freq_range: tuple[float, float]\n    minimum_amplitude: float = Field(default=0.3, gt=0.05, lt=0.5)\n    offset: float = 0.0\n\n    @field_validator(\"freq_range\")\n    @classmethod\n    def _validate_freq_range(cls, value: tuple[float, float]) -> tuple[float, float]:\n        if len(value) != 2:\n            raise ValueError(\"freq_range must contain exactly two elements\")\n        fmin = _positive_finite(value[0], field_name=\"freq_range[0]\")\n        fmax = _positive_finite(value[1], field_name=\"freq_range[1]\")\n        if fmax <= fmin:\n            raise ValueError(\"freq_range[1] must be greater than freq_range[0]\")\n        return (fmin, fmax)\n\n    @property\n    def freq0(self) -> float:\n        return 0.5 * (self.freq_range[0] + self.freq_range[1])\n\n    @property\n    def bandwidth(self) -> float:\n        return self.freq_range[1] - self.freq_range[0]\n\n    @property\n    def fwidth(self) -> float:\n        half_range = 0.5 * self.bandwidth\n        return half_range / math.sqrt(2.0 * math.log(1.0 / self.minimum_amplitude))\n\n    @property\n    def twidth(self) -> float:\n        return 1.0 / (2.0 * math.pi * self.fwidth)\n\n    @property\n    def automatic_delay(self) -> float:\n        return 5.0 * self.twidth\n\n    @property\n    def offset_time(self) -> float:\n        range_twidth = 1.0 / (2.0 * math.pi * self.bandwidth)\n        return self.automatic_delay + self.offset * range_twidth\n\n    @property\n    def peak_time(self) -> float:\n        return self.offset_time\n\n    def amp_time(self, time: float | Sequence[float]) -> np.ndarray:\n        times = _normalize_times(time)\n        omega0 = 2.0 * math.pi * self.freq0\n        shifted = times - self.offset_time\n        return (\n            1j\n            * np.exp(1j * self.phase)\n            * np.exp(-1j * omega0 * times)\n            * np.exp(-(shifted**2) / (2.0 * self.twidth**2))\n            * self.amplitude\n        )\n\n    def amp_freq(self, freq: float | Sequence[float]) -> np.ndarray:\n        freqs = np.asarray(freq, dtype=float)\n        if freqs.ndim == 0:\n            freqs = freqs.reshape(1)\n        if freqs.ndim != 1 or not np.all(np.isfinite(freqs)):\n            raise ValueError(\"frequency samples must be a scalar or one-dimensional finite sequence\")\n        spread = np.exp(-((freqs - self.freq0) ** 2) / (2.0 * self.fwidth**2))\n        return self.amplitude * np.exp(1j * self.phase) * spread\n\n    def frequency_range_sigma(self, sigma: float = DEFAULT_SIGMA) -> tuple[float, float]:\n        sigma_value = _positive_finite(sigma, field_name=\"sigma\")\n        return (\n            max(0.0, self.freq0 - sigma_value * self.fwidth),\n            self.freq0 + sigma_value * self.fwidth,\n        )\n\n    def frequency_range(self, num_fwidth: float = DEFAULT_SIGMA) -> tuple[float, float]:\n        return self.frequency_range_sigma(sigma=num_fwidth)\n\n    def end_time(self) -> float:\n        return self.offset_time + END_TIME_FACTOR_GAUSSIAN * self.twidth\n\n\nSourceTimeModel = GaussianPulse | ContinuousWave | BroadbandPulse | CustomSourceTime\n\n\ndef source_time_model_from_value(value: object) -> SourceTimeModel:\n    \"\"\"Coerce a mapping payload into a supported Phase 1 source-time profile.\"\"\"\n\n    if isinstance(value, (GaussianPulse, ContinuousWave, BroadbandPulse, CustomSourceTime)):\n        return value\n    if not isinstance(value, Mapping):\n        raise TypeError(f\"expected a mapping or source-time model, got {type(value)!r}\")\n\n    source_time_type = str(value.get(\"type\", \"\"))\n    if source_time_type == \"GaussianPulse\":\n        return GaussianPulse.model_validate(value)\n    if source_time_type == \"ContinuousWave\":\n        return ContinuousWave.model_validate(value)\n    if source_time_type == \"BroadbandPulse\":\n        return BroadbandPulse.model_validate(value)\n    if source_time_type == \"CustomSourceTime\":\n        return CustomSourceTime.model_validate(value)\n    raise TypeError(f\"unsupported Phase 1 source-time type {source_time_type!r}\")\n","numLines":406,"startLine":1,"totalLines":406}}}
