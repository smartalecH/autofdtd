@@ -0,0 +1,40 @@
+"""Runtime-facing boundary orchestration for the foundational non-absorbing Phase 1 surface."""
+
+from __future__ import annotations
+
+import numpy as np
+
+from autofdtd.compiler.boundaries import CompiledBoundarySpec, compile_boundary_spec
+from autofdtd.kernels.boundaries import apply_boundary_ghosts
+
+
+class BoundaryRuntime:
+    """Small runtime wrapper around compiled non-absorbing boundary metadata."""
+
+    def __init__(self, boundary_spec: object | None = None) -> None:
+        self.compiled = compile_boundary_spec(boundary_spec)
+
+    def apply(
+        self,
+        electric_field: np.ndarray,
+        magnetic_field: np.ndarray,
+    ) -> tuple[np.ndarray, np.ndarray]:
+        """Apply ghost-cell updates for both field families."""
+
+        return apply_boundary_ghosts(electric_field, magnetic_field, self.compiled)
+
+
+def build_boundary_runtime(boundary_spec: object | None = None) -> BoundaryRuntime:
+    """Build the default Phase 1 boundary runtime wrapper."""
+
+    return BoundaryRuntime(boundary_spec)
+
+
+def apply_compiled_boundaries(
+    electric_field: np.ndarray,
+    magnetic_field: np.ndarray,
+    compiled_boundary_spec: CompiledBoundarySpec,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Apply boundary ghosts using a precompiled boundary specification."""
+
+    return apply_boundary_ghosts(electric_field, magnetic_field, compiled_boundary_spec)
