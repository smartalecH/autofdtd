+                "should only be used for small smoke tests.",
+                AutoFDTDValidationWarning,
+                stacklevel=2,
+            )
+        return normalized
+
+
+ImplementedBoundaryEdge = (
+    Periodic | BlochBoundary | PECBoundary | PMCBoundary | PML | StablePML | Absorber
+)
