+    curl_h = np.array([[0.1, 0.2, -0.1], [0.05, -0.3, 0.4]])
+    curl_e = np.array([[0.2, -0.4, 0.1], [-0.3, 0.2, 0.5]])
+    state = allocate_anisotropic_state(coeffs, field_shape=electric.shape[:-1])
