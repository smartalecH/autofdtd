+        raise ValueError("ABC state allocation expects field shapes (nx, ny, nz, 3)")
+    electric: dict[str, ABCFaceState] = {}
+    magnetic: dict[str, ABCFaceState] = {}
+
+    for axis_boundary in compiled_boundary_spec.axes():
