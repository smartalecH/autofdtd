+def test_pml_boundary_stages_absorb_boundary_energy() -> None:
+    compiled = compile_boundary_spec(
+        BoundarySpec(x=Boundary.pml(num_layers=4), y=Boundary.periodic(), z=Boundary.periodic()),
+        dt=0.5,
