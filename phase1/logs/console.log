{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_0rv2vqrk9yds_3","type":"tool_result","content":"1\t\"\"\"Examples for Phase 1 current-source placement and injection.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport numpy as np\n6\t\n7\tfrom autofdtd.api import (\n8\t    ContinuousWave,\n9\t    GridSpec,\n10\t    Simulation,\n11\t    UniformCurrentSource,\n12\t    UniformGrid,\n13\t)\n14\tfrom autofdtd.runtime import apply_uniform_current_sources, build_uniform_current_runtime\n15\t\n16\t\n17\tdef uniform_current_source_snapshot() -> dict[str, object]:\n18\t    \"\"\"Return a compact snapshot of source placement and one injection step.\"\"\"\n19\t\n20\t    simulation = Simulation(\n21\t        size=(4.0, 4.0, 4.0),\n22\t        run_time=1.0,\n23\t        grid_spec=GridSpec(\n24\t            grid_x=UniformGrid(dl=1.0),\n25\t            grid_y=UniformGrid(dl=1.0),\n26\t            grid_z=UniformGrid(dl=1.0),\n27\t        ),\n28\t        sources=(\n29\t            UniformCurrentSource(\n30\t                center=(0.0, 0.0, 0.5),\n31\t                size=(0.0, 2.0, 0.0),\n32\t                polarization=\"Ez\",\n33\t                current_amplitude_definition=\"total\",\n34\t                source_time=ContinuousWave(freq0=1.0, fwidth=1.0, amplitude=1.0, offset=2.5),\n35\t                name=\"sheet_drive\",\n36\t            ),\n37\t        ),\n38\t    )\n39\t    compiled = build_uniform_current_runtime(\n40\t        simulation.sources[0],\n41\t        grid=simulation.resolved_grid(),\n42\t    )\n43\t    electric = np.zeros((4, 4, 4, 3), dtype=np.complex128)\n44\t    magnetic = np.zeros_like(electric)\n45\t    injected_electric, _ = apply_uniform_current_sources(\n46\t        electric,\n47\t        magnetic,\n48\t        (compiled,),\n49\t        time=0.0,\n50\t        dt=0.25,\n51\t    )\n52\t    return {\n53\t        \"placement_kind\": compiled.placement_kind,\n54\t        \"support_point_count\": compiled.support_point_count,\n55\t        \"placements\": compiled.placements,\n56\t        \"amplitude_scale\": compiled.amplitude_scale,\n57\t        \"sum_abs_injected_e\": float(np.sum(np.abs(injected_electric[..., 2]))),\n58\t    }\n59\t"}]},"parent_tool_use_id":null,"session_id":"9f649c44-f5ed-43a2-9485-dc3f20705005","uuid":"9139485b-c810-4c05-a5f6-b37a5a7c1e27","timestamp":"2026-04-06T23:44:43.303Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/autofdtd/src/autofdtd/examples/current_sources.py","content":"\"\"\"Examples for Phase 1 current-source placement and injection.\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\n\nfrom autofdtd.api import (\n    ContinuousWave,\n    GridSpec,\n    Simulation,\n    UniformCurrentSource,\n    UniformGrid,\n)\nfrom autofdtd.runtime import apply_uniform_current_sources, build_uniform_current_runtime\n\n\ndef uniform_current_source_snapshot() -> dict[str, object]:\n    \"\"\"Return a compact snapshot of source placement and one injection step.\"\"\"\n\n    simulation = Simulation(\n        size=(4.0, 4.0, 4.0),\n        run_time=1.0,\n        grid_spec=GridSpec(\n            grid_x=UniformGrid(dl=1.0),\n            grid_y=UniformGrid(dl=1.0),\n            grid_z=UniformGrid(dl=1.0),\n        ),\n        sources=(\n            UniformCurrentSource(\n                center=(0.0, 0.0, 0.5),\n                size=(0.0, 2.0, 0.0),\n                polarization=\"Ez\",\n                current_amplitude_definition=\"total\",\n                source_time=ContinuousWave(freq0=1.0, fwidth=1.0, amplitude=1.0, offset=2.5),\n                name=\"sheet_drive\",\n            ),\n        ),\n    )\n    compiled = build_uniform_current_runtime(\n        simulation.sources[0],\n        grid=simulation.resolved_grid(),\n    )\n    electric = np.zeros((4, 4, 4, 3), dtype=np.complex128)\n    magnetic = np.zeros_like(electric)\n    injected_electric, _ = apply_uniform_current_sources(\n        electric,\n        magnetic,\n        (compiled,),\n        time=0.0,\n        dt=0.25,\n    )\n    return {\n        \"placement_kind\": compiled.placement_kind,\n        \"support_point_count\": compiled.support_point_count,\n        \"placements\": compiled.placements,\n        \"amplitude_scale\": compiled.amplitude_scale,\n        \"sum_abs_injected_e\": float(np.sum(np.abs(injected_electric[..., 2]))),\n    }\n","numLines":59,"startLine":1,"totalLines":59}}}
