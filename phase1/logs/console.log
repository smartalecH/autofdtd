+    axis_index: int,
+    side: Literal["minus", "plus"],
+) -> None:
+    ghost, adjacent = _abc_state_slices(axis_index, side, ndim=field.ndim)
+    current_adjacent = np.array(field[adjacent], copy=True)
+    next_boundary = (
