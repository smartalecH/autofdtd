+        if freqs.ndim != 1 or not np.all(np.isfinite(freqs)):
+            raise ValueError("frequency samples must be a scalar or one-dimensional finite sequence")
+        spread = np.exp(-((freqs - self.freq0) ** 2) / (2.0 * self.fwidth**2))
