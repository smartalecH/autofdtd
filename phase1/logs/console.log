+def _pml_region_slices(
+    axis_index: int,
+    side: Literal["minus", "plus"],
+    num_layers: int,
+    *,
+    ndim: int,
+) -> tuple[object, ...]:
+    region = [slice(None)] * ndim
+    if side == "minus":
+        region[axis_index] = slice(1, 1 + num_layers)
+    else:
+        region[axis_index] = slice(-1 - num_layers, -1)
