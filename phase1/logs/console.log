+class CustomAnisotropicMedium(TaggedModel):
+    """Rejected Phase 1 surface for sampled spatially varying diagonal anisotropy."""
+
+    type: Literal["CustomAnisotropicMedium"] = "CustomAnisotropicMedium"
+    name: str | None = None
