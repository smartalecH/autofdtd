+
+    assert set(state.electric) == {"x.minus", "x.plus", "z.minus"}
+    assert state.electric["x.minus"].memory_shape == (3, 8, 6, 3)
+    assert state.electric["z.minus"].memory_shape == (12, 8, 2, 3)
