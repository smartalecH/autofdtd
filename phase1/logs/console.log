diff --git a/src/autofdtd/runtime/boundaries.py b/src/autofdtd/runtime/boundaries.py
new file mode 100644
index 0000000000000000000000000000000000000000..4d150e9afd5f4fd657236ea16e5e81d48469d9b1
--- /dev/null
+++ b/src/autofdtd/runtime/boundaries.py
@@ -0,0 +1,40 @@
+"""Runtime-facing boundary orchestration for the foundational non-absorbing Phase 1 surface."""
+
+from __future__ import annotations
+
+import numpy as np
+
+from autofdtd.compiler.boundaries import CompiledBoundarySpec, compile_boundary_spec
+from autofdtd.kernels.boundaries import apply_boundary_ghosts
+
+
+class BoundaryRuntime:
+    """Small runtime wrapper around compiled non-absorbing boundary metadata."""
+
+    def __init__(self, boundary_spec: object | None = None) -> None:
+        self.compiled = compile_boundary_spec(boundary_spec)
+
+    def apply(
+        self,
+        electric_field: np.ndarray,
+        magnetic_field: np.ndarray,
+    ) -> tuple[np.ndarray, np.ndarray]:
+        """Apply ghost-cell updates for both field families."""
+
+        return apply_boundary_ghosts(electric_field, magnetic_field, self.compiled)
+
+
+def build_boundary_runtime(boundary_spec: object | None = None) -> BoundaryRuntime:
+    """Build the default Phase 1 boundary runtime wrapper."""
+
+    return BoundaryRuntime(boundary_spec)
+
+
+def apply_compiled_boundaries(
+    electric_field: np.ndarray,
+    magnetic_field: np.ndarray,
+    compiled_boundary_spec: CompiledBoundarySpec,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Apply boundary ghosts using a precompiled boundary specification."""
+
+    return apply_boundary_ghosts(electric_field, magnetic_field, compiled_boundary_spec)
diff --git a/tests/test_boundaries.py b/tests/test_boundaries.py
new file mode 100644
index 0000000000000000000000000000000000000000..f22a82cd305c08e9147ab1d478ef355d2d218aa5
--- /dev/null
+++ b/tests/test_boundaries.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from autofdtd.api import Boundary, BoundarySpec, PECBoundary, PMCBoundary, Periodic, Simulation
+from autofdtd.compiler import BoundaryMode, compile_boundary_spec
+from autofdtd.core.validation import AutoFDTDValidationWarning
+from autofdtd.ir import BoundarySpecIR, simulation_to_ir
+from autofdtd.kernels import apply_boundary_ghosts, boundary_kernel_metadata
+from autofdtd.runtime import build_boundary_runtime
+
+
+def test_boundary_coerces_periodic_opposite_conductor_with_warning() -> None:
+    with pytest.warns(
+        AutoFDTDValidationWarning,
+        match="periodic boundary opposite a PEC/PMC boundary",
+    ):
+        boundary = Boundary(minus=PECBoundary(), plus=Periodic())
+
+    assert boundary.minus.type == "PECBoundary"
+    assert boundary.plus.type == "PECBoundary"
+
+
+def test_simulation_normalizes_supported_boundary_subset() -> None:
+    simulation = Simulation(
+        size=(1.0, 1.0, 1.0),
+        run_time=1.0,
+        boundary_spec={
+            "type": "BoundarySpec",
+            "x": {"type": "Periodic"},
+            "y": {
+                "type": "Boundary",
+                "minus": {"type": "PECBoundary"},
+                "plus": {"type": "Periodic"},
+            },
+            "z": {"type": "PMCBoundary"},
+        },
+    )
+
+    assert simulation.boundary_spec["x"]["minus"]["type"] == "Periodic"
+    assert simulation.boundary_spec["x"]["plus"]["type"] == "Periodic"
+    assert simulation.boundary_spec["y"]["minus"]["type"] == "PECBoundary"
+    assert simulation.boundary_spec["y"]["plus"]["type"] == "PECBoundary"
+    assert simulation.boundary_spec["z"]["minus"]["type"] == "PMCBoundary"
+    assert simulation.boundary_spec["z"]["plus"]["type"] == "PMCBoundary"
+
+
+def test_compile_boundary_spec_builds_runtime_modes_and_rejects_unsupported_edges() -> None:
+    compiled = compile_boundary_spec(
+        BoundarySpec(x=Boundary.periodic(), y=Boundary.pec(), z=Boundary.pmc())
+    )
+
+    assert compiled.x.exchange_kind == "periodic"
+    assert compiled.y.minus.mode is BoundaryMode.PEC
+    assert compiled.z.plus.mode is BoundaryMode.PMC
+    assert compiled.periodic_axes == ("x",)
+    assert compiled.reflective_axes == ("y", "z")
+
+    with pytest.raises(ValueError, match="supports only BoundarySpec with Periodic, PECBoundary, and PMCBoundary"):
+        compile_boundary_spec({"type": "BoundarySpec", "x": {"type": "PML"}})
+
+
+def test_boundary_kernels_apply_periodic_and_reflective_ghost_updates() -> None:
+    compiled = compile_boundary_spec(
+        BoundarySpec(x=Boundary.periodic(), y=Boundary.pec(), z=Boundary.pmc())
+    )
+    electric = np.zeros((4, 4, 4, 3), dtype=np.float64)
+    magnetic = np.zeros((4, 4, 4, 3), dtype=np.float64)
+
+    electric[1, 1, 1] = (1.0, 2.0, 3.0)
+    electric[-2, 1, 1] = (4.0, 5.0, 6.0)
+    electric[2, 1, 2] = (7.0, 8.0, 9.0)
+    electric[1, -2, 2] = (11.0, 12.0, 13.0)
+    electric[2, 2, 1] = (14.0, 15.0, 16.0)
+    electric[1, 2, -2] = (17.0, 18.0, 19.0)
+
+    magnetic[1, 1, 1] = (21.0, 22.0, 23.0)
+    magnetic[-2, 1, 1] = (24.0, 25.0, 26.0)
+    magnetic[2, 1, 2] = (27.0, 28.0, 29.0)
+    magnetic[2, -2, 2] = (31.0, 32.0, 33.0)
+    magnetic[2, 2, 1] = (34.0, 35.0, 36.0)
+    magnetic[2, 2, -2] = (37.0, 38.0, 39.0)
+
+    updated_electric, updated_magnetic = apply_boundary_ghosts(electric, magnetic, compiled)
+
+    assert tuple(updated_electric[0, 1, 1]) == pytest.approx((4.0, 5.0, 6.0))
+    assert tuple(updated_electric[-1, 1, 1]) == pytest.approx((1.0, 2.0, 3.0))
+    assert tuple(updated_magnetic[0, 1, 1]) == pytest.approx((24.0, 25.0, 26.0))
+    assert tuple(updated_electric[2, 0, 2]) == pytest.approx((-7.0, 8.0, -9.0))
+    assert tuple(updated_magnetic[2, 0, 2]) == pytest.approx((27.0, -28.0, 29.0))
+    assert tuple(updated_electric[2, 2, 0]) == pytest.approx((14.0, 15.0, -16.0))
+    assert tuple(updated_magnetic[2, 2, -1]) == pytest.approx((-37.0, -38.0, 39.0))
+
+
+def test_boundary_runtime_wrapper_and_ir_lowering_expose_typed_metadata() -> None:
+    boundary_spec = BoundarySpec(x=Boundary.periodic(), y=Boundary.pec(), z=Boundary.pmc())
+    runtime = build_boundary_runtime(boundary_spec)
+    metadata = boundary_kernel_metadata()
+    simulation_ir = simulation_to_ir(
+        Simulation(size=(1.0, 1.0, 1.0), run_time=1.0, boundary_spec=boundary_spec)
+    )
+
+    assert runtime.compiled.periodic_axes == ("x",)
+    assert metadata["supported_modes"] == ("periodic", "pec", "pmc")
+    assert isinstance(simulation_ir.boundary_spec, BoundarySpecIR)
+    assert simulation_ir.boundary_spec.reflective_axes == ("y", "z")

