+    elif isinstance(value, Mapping) and str(value.get("type")) in {"Boundary", "Periodic", "PECBoundary", "PMCBoundary"}:
+        boundary = boundary_model_from_value(value)
+    if boundary is None:
+        return component_to_ir(value, family=ComponentFamily.BOUNDARY)
+    return BoundaryIR(
