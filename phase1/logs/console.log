+def _grid_axis_to_ir(value: object) -> GridAxisIR:
+    grid = value if isinstance(value, (UniformGrid, CustomGridBoundaries, CustomGrid)) else grid_model_from_value(value)
+    if isinstance(grid, UniformGrid):
